# Chave da IA usada no backend para o preenchimento automático do CV.
# Em Lovable esta chave é fornecida automaticamente (LOVABLE_API_KEY).
# Em auto-alojamento (ex.: Render), defina uma das seguintes:
LOVABLE_API_KEY=
GEMINI_API_KEY=

# Porta usada pelo servidor de produção (o Render define automaticamente)
PORT=3000
